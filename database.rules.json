{
  "rules": {
    ".read": false,
    ".write": false,

    "table": {
      ".read": true,
      ".write": true
    },

    "archive": {
      ".read": true,
      ".indexOn": "finishedAt",
      "$entry": {
        ".write": "!data.exists() && newData.hasChildren(['finishedAt','winner','scores'])",
        "winner":     { ".validate": "newData.isString() && newData.val().length <= 40" },
        "quote":      { ".validate": "newData.isString() && newData.val().length <= 140" },
        "finishedAt": { ".validate": "newData.isNumber()" },
        "scores": {
          "$i": {
            "name":  { ".validate": "newData.isString() && newData.val().length <= 14" },
            "score": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
